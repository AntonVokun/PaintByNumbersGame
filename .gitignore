# Unity generated folders (project root only; keep same-named asset folders)
# Reference: https://github.com/github/gitignore/blob/main/Unity.gitignore
/[Ll]ibrary/
/[Tt]emp/
/.utmp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory captures and recordings
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity crash / diagnostic files
sysinfo.txt
mono_crash.*
*.stackdump

# Unity package exports
*.unitypackage
*.unitypackage.meta

# Android / mobile build outputs
.gradle/
*.apk
*.aab
*.apks
*.keystore
*.jks

# iOS / macOS build outputs
*.app
*.ipa

# Visual Studio / Rider / VS Code / Cursor generated files
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.user
*.userprefs
*.suo
*.tmp
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# Bundled resolver symbols are source assets supplied with the plugin
!/Assets/MobileDependencyResolver/**/*.pdb

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.bak
*.swp
*.pid
